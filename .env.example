# Copie este arquivo para ".env" e troque os valores.
# Nada aqui deve ir para o GitHub: o arquivo .env já está no .gitignore.

# Porta em que o site vai rodar
PORTA=3000

# ---------------------------------------------------------------------
# CONTA INICIAL DE ACESSO AO PAINEL
# Usada UMA ÚNICA VEZ, quando o site sobe e ainda não existe nenhuma conta.
# Depois disso as contas ficam em dados/usuarios.json (senhas com hash)
# e você gerencia com: node ferramentas/contas.js
#
# Se deixar SENHA_INICIAL em branco, o site sorteia uma senha forte e
# mostra no terminal na primeira execução.
# ---------------------------------------------------------------------
USUARIO_INICIAL=admin
SENHA_INICIAL=
NOME_INICIAL=Administrador

# Token usado por sites externos (Tally, Typeform, Elementor, Zapier...)
# para enviar inscrições para /api/webhook/lead
TOKEN_WEBHOOK=troque-este-token

# Cookie de login só trafega em https?
#   auto   = liga sozinho quando o acesso é https (recomendado)
#   sempre = force assim se o seu site só responde em https
#   nunca  = só para depurar em http, nunca em produção
COOKIE_SEGURO=auto

# Nome da sua empresa/programa, aparece no site e no painel
NOME_PROGRAMA=Programa de Parceria

# Número de WhatsApp que recebe o contato (somente números, com DDI)
WHATSAPP_CONTATO=5511999999999
